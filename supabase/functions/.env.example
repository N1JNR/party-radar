# Copie para supabase/functions/.env (ignorado pelo Git). As Edge Functions locais leem este arquivo.
# Chave da Steam Web API: https://steamcommunity.com/dev/apikey (só no servidor, nunca no front).
STEAM_WEB_API_KEY=
# Origens em que o app roda; a volta do "Entrar pela Steam" só vale para elas.
APP_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
