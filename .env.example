# Copie para .env e preencha. O .env NUNCA vai para o Git.
# Usado pelo Supabase local (supabase/config.toml lê com env()), pelo worker do Discord e pelas
# Edge Functions. O Angular não lê este arquivo.

SUPABASE_URL=http://127.0.0.1:54321
# Secret key (sb_secret_…): só no servidor, nunca no front.
SUPABASE_SECRET_KEY=

# Login com o Discord: aplicativo em https://discord.com/developers/applications, com o retorno
# http://127.0.0.1:54321/auth/v1/callback em OAuth2 > Redirects. Depois de preencher, reinicie o
# Supabase local (npx supabase stop && npm run db:start).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

STEAM_WEB_API_KEY=
